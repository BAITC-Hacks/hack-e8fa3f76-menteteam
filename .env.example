# Models run inside Python. Local directories also accepted.
WHISPER_MODEL=large-v3
AI_DEVICE=cuda
WHISPER_COMPUTE=int8_float16
GEMMA_MODEL=google/gemma-4-E2B-it
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# Accept Community-1 terms, then use a read token to prepare weights.
HF_TOKEN=
# Enable only after preparing local model directories and dependencies.
ALEM_OFFLINE=0
# ALEM_DATA_DIR=/absolute/path/to/private/data
CAPTURE_PORT=8765
# Optional internal SMTP. No delivery unless worker runs with --send.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
